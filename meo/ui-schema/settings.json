{
  "schemaVersion": 1,
  "sections": [
    {
      "id": "general",
      "label": "General",
      "labelKey": "meo.settings.general",
      "owner": "client",
      "group": "Preferences",
      "items": [
        {
          "id": "enter_to_send",
          "label": "Enter to send",
          "labelKey": "meo.settings.enterToSend",
          "kind": "toggle",
          "binding": "general.enter_to_send",
          "description": "Press Enter to send a message. Shift+Enter starts a new line."
        },
        {
          "id": "language",
          "label": "Language",
          "labelKey": "meo.settings.language",
          "kind": "select",
          "binding": "appearance.language",
          "options": [
            "system",
            "en",
            "zh-CN"
          ],
          "description": "The language of menus and buttons."
        }
      ],
      "keywords": [
        "keyboard",
        "enter",
        "language",
        "输入",
        "语言"
      ]
    },
    {
      "id": "appearance",
      "label": "Appearance",
      "labelKey": "meo.settings.appearance",
      "owner": "client",
      "group": "Preferences",
      "items": [
        {
          "id": "theme",
          "label": "Theme",
          "labelKey": "meo.settings.theme",
          "kind": "select",
          "binding": "appearance.theme",
          "options": [
            "system",
            "light",
            "dark"
          ],
          "description": "Light, dark, or the same as your system."
        },
        {
          "id": "text_size",
          "label": "Text size",
          "labelKey": "meo.settings.textSize",
          "kind": "select",
          "binding": "appearance.text_size",
          "options": [
            "small",
            "default",
            "large"
          ],
          "description": "Makes the text in the app smaller or larger."
        },
        {
          "id": "reduce_motion",
          "label": "Reduce motion",
          "labelKey": "meo.settings.reduceMotion",
          "kind": "toggle",
          "binding": "appearance.reduce_motion",
          "description": "Turns off sliding and fading animations."
        }
      ],
      "keywords": [
        "theme",
        "dark",
        "font",
        "size",
        "motion",
        "外观",
        "字体",
        "动效"
      ]
    },
    {
      "id": "personalization",
      "label": "Personalization & memory",
      "labelKey": "meo.settings.personalization",
      "owner": "core",
      "group": "Preferences",
      "items": [
        {
          "id": "custom_instructions",
          "label": "Custom instructions",
          "labelKey": "meo.settings.instructions",
          "kind": "text",
          "binding": "personalization.custom_instructions",
          "maxLength": 8000,
          "description": "Tell Meo how you like answers: tone, format, anything it should always keep in mind."
        },
        {
          "id": "response_language",
          "label": "Response language",
          "labelKey": "meo.settings.language",
          "kind": "select",
          "binding": "personalization.response_language",
          "options": [
            "system",
            "en",
            "zh-CN",
            "zh-TW",
            "ja",
            "ko",
            "es",
            "fr",
            "de"
          ],
          "description": "The language Meo answers in, whatever language you write in."
        },
        {
          "id": "memory_enabled",
          "label": "Use saved memories",
          "labelKey": "meo.settings.memoryEnabled",
          "kind": "toggle",
          "binding": "memory.enabled",
          "description": "Let Meo remember useful facts about you between chats."
        }
      ],
      "keywords": [
        "memory",
        "instructions",
        "记忆",
        "指令"
      ]
    },
    {
      "id": "notifications",
      "label": "Notifications",
      "labelKey": "meo.settings.notifications",
      "owner": "client",
      "group": "Preferences",
      "items": [
        {
          "id": "answers",
          "label": "Notify me when an answer is ready in the background",
          "labelKey": "meo.settings.notifyAnswers",
          "kind": "toggle",
          "binding": "notifications.answers",
          "description": "A system notification when an answer finishes while Meo is in the background."
        }
      ],
      "keywords": [
        "notify",
        "alert",
        "通知",
        "提醒"
      ]
    },
    {
      "id": "shortcuts",
      "label": "Keyboard shortcuts",
      "labelKey": "meo.settings.shortcuts",
      "owner": "client",
      "group": "Preferences",
      "items": [],
