# Copy this file to .env. Never commit .env.
MEO_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
MEO_ACCOUNT_URL=https://account.meoarch.org
MEO_ALLOWED_WEB_ORIGINS=https://account.meoarch.org,https://chat.meoarch.org
PORT=8080

# Match the owner of the mode-600 Tunnel credentials (id -u / id -g).
MEO_CLOUDFLARED_UID=1000
MEO_CLOUDFLARED_GID=1000
