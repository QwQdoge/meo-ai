{
  "id": "org.meo.MeoAI",
  "name": "Meo AI",
  "oauthClientId": "meo-ai-native",
  "redirectUri": "meoai://auth/callback",
  "executables": [
    "/usr/bin/meo-ai",
    "/usr/bin/meo-agent-service"
  ],
  "scopes": [
    "openid",
    "profile",
    "email",
    "offline_access",
    "meo:read",
    "meo:write"
  ],
  "capabilities": [
    "ai_usage_sync",
    "local_ai"
  ]
}
