[Unit]
Description=Meo AI remote device bridge
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@bindir@/meo-agentd
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
