[Unit]
Description=Meo AI remote device bridge
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@bindir@/meo-agentd
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/meo

[Install]
WantedBy=default.target
